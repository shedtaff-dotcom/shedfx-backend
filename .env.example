# ShedFX backend configuration. Copy to .env and edit.

# SQLite database location (SQLAlchemy URL).
DATABASE_URL=sqlite:///./shedfx.db

# Reserved for Phase 7 — TONE3000 API access. Not used yet.
TONE3000_API_KEY=

# Reserved — Tailscale is configured on the Pi itself, not in the app.
# See README for the remote-access note.
TAILSCALE_HOSTNAME=
